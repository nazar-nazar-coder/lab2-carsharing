      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('status paid', () => pm.expect(pm.response.json().status).to.eql('paid'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Booking: список бронювань",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const id = Number(pm.collectionVariables.get('bookingId'));",
              "pm.test('created booking is listed', () => pm.expect(pm.response.json().map(b => b.id)).to.include(id));"
            ]
          }
