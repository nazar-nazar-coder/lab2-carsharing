        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('service is healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
